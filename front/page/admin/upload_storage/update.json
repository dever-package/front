{
  "page": {
    "name": "存储方式编辑",
    "parent": "front/upload_storage/list",
    "sort": 10,
    "auth": [
      {
        "key": "front/upload_storage/create",
        "name": "存储方式新增",
        "query": {
          "id": "empty"
        }
      },
      {
        "key": "front/upload_storage/update",
        "name": "存储方式编辑",
        "query": {
          "id": "required"
        }
      }
    ]
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full"
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-input",
        "name": "存储方式名称",
        "placeholder": "例如：本地存储 / 七牛云华东 / 飞书云盘",
        "value": "form.name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "名称不能为空。"
          }
        ],
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "id": "upload-storage-type",
        "type": "form-select",
        "name": "存储类型",
        "placeholder": "请选择存储类型",
        "value": "form.type",
        "mode": "form",
        "option": "option.type",
        "validate": [
          {
            "type": "required",
            "message": "存储类型不能为空。"
          }
        ],
        "meta": {
          "formLayout": "horizontal",
          "controlClassName": "max-w-[240px]"
        }
      },
      {
        "id": "upload-storage-path-mode",
        "type": "form-radio",
        "name": "文件组织方式",
        "placeholder": "请选择文件组织方式",
        "value": "form.path_mode",
        "mode": "form",
        "option": "option.path_mode",
        "info": "自动适配：本地和七牛使用内容哈希，飞书使用来源目录；来源目录会按资源来源和最终文件名保存，重名时追加内容摘要。修改后只影响新上传文件，不会移动或重命名历史文件。",
        "validate": [
          {
            "type": "required",
            "message": "文件组织方式不能为空。"
          }
        ],
        "meta": {
          "formLayout": "horizontal",
          "orientation": "horizontal"
        }
      },
      {
        "id": "upload-storage-qiniu-access-key",
        "type": "form-input",
        "name": "AccessKey",
        "placeholder": "输入七牛云 AccessKey",
        "value": "form.access_key",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "AccessKey 不能为空。",
            "when": [
              {
                "path": "form.type",
                "operator": "equals",
                "value": "qiniu"
              }
            ]
          }
        ],
        "meta": {
          "formLayout": "horizontal",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "qiniu"
            }
          ]
        }
      },
      {
        "id": "upload-storage-qiniu-secret-key",
        "type": "form-password",
        "name": "SecretKey",
        "placeholder": "输入七牛云 SecretKey",
        "value": "form.secret_key",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "SecretKey 不能为空。",
            "when": [
              {
                "path": "form.type",
                "operator": "equals",
                "value": "qiniu"
              }
            ]
          }
        ],
        "meta": {
          "formLayout": "horizontal",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "qiniu"
            }
          ]
        }
      },
      {
        "id": "upload-storage-qiniu-bucket",
        "type": "form-input",
        "name": "Bucket",
        "placeholder": "输入七牛云 Bucket",
        "value": "form.bucket",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "Bucket 不能为空。",
            "when": [
              {
                "path": "form.type",
                "operator": "equals",
                "value": "qiniu"
              }
            ]
          }
        ],
        "meta": {
          "formLayout": "horizontal",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "qiniu"
            }
          ]
        }
      },
      {
        "id": "upload-storage-feishu-app-id",
        "type": "form-input",
        "name": "App ID",
        "placeholder": "输入飞书自建应用 App ID",
        "value": "form.access_key",
        "mode": "form",
        "info": "使用企业自建应用，应用需已发布并开通云空间文件读写权限。",
        "validate": [
          {
            "type": "required",
            "message": "App ID 不能为空。",
            "when": [
              {
                "path": "form.type",
                "operator": "equals",
                "value": "feishu"
              }
            ]
          }
        ],
        "meta": {
          "formLayout": "horizontal",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "feishu"
            }
          ]
        }
      },
      {
        "id": "upload-storage-feishu-app-secret",
        "type": "form-password",
        "name": "App Secret",
        "placeholder": "编辑时留空表示保留已有 App Secret",
        "value": "form.secret_key",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "App Secret 不能为空。",
            "when": [
              {
                "path": "form.type",
                "operator": "equals",
                "value": "feishu"
              },
              {
                "path": "form.id",
                "operator": "empty"
              }
            ]
          }
        ],
        "info": "App Secret 不会在编辑页面回显，留空会保留原值。",
        "meta": {
          "formLayout": "horizontal",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "feishu"
            }
          ]
        }
      },
      {
        "id": "upload-storage-feishu-folder-token",
        "type": "form-input",
        "name": "目标文件夹 Token",
        "placeholder": "例如：fldbcO1UuPz8VwnpPx5a92...",
        "value": "form.bucket",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "目标文件夹 Token 不能为空。",
            "when": [
              {
                "path": "form.type",
                "operator": "equals",
                "value": "feishu"
              }
            ]
          }
        ],
        "info": "配置流程：为自建应用添加机器人能力、开通 drive:drive 权限并发布；创建仅自己的授权群并添加应用机器人；在云盘新建专用文件夹，以可编辑权限共享给该群；浏览器打开文件夹后，仅复制地址中 /drive/folder/ 后的 Token（不要填写完整链接）。",
        "meta": {
          "formLayout": "horizontal",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "feishu"
            }
          ]
        }
      },
      {
        "id": "upload-storage-domain",
        "type": "form-input",
        "name": "访问域名",
        "placeholder": "例如：https://cdn.example.com 或 http://127.0.0.1:8085",
        "value": "form.domain",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "访问域名不能为空。",
            "when": [
              {
                "path": "form.type",
                "operator": "equals",
                "value": "qiniu"
              }
            ]
          }
        ],
        "info": "七牛云必须填写访问域名；本地存储可留空，留空时会默认使用当前服务的 /upload/... 直链。",
        "meta": {
          "formLayout": "horizontal",
          "showCondition": "any",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "local"
            },
            {
              "path": "form.type",
              "operator": "equals",
              "value": "qiniu"
            }
          ]
        }
      },
      {
        "id": "upload-storage-upload-host",
        "type": "form-input",
        "name": "上传域名",
        "placeholder": "例如：https://upload.qiniup.com",
        "value": "form.upload_host",
        "mode": "form",
        "info": "留空时会使用七牛默认上传域名。",
        "meta": {
          "formLayout": "horizontal",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "qiniu"
            }
          ]
        }
      },
      {
        "id": "upload-storage-token-ttl",
        "type": "form-number",
        "name": "直传凭证有效期",
        "placeholder": "例如：3600",
        "value": "form.token_ttl",
        "mode": "form",
        "info": "仅七牛前端直传使用，默认 3600 秒。",
        "meta": {
          "formLayout": "horizontal",
          "controlClassName": "max-w-[240px]",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "qiniu"
            }
          ]
        }
      }
    ]
  },
  "data": {
    "form": {
      "service": "front.upload.UploadStorageHook.AttachUploadStorageForm",
      "id": "",
      "name": "",
      "type": "local",
      "path_mode": "auto",
      "access_key": "",
      "secret_key": "",
      "bucket": "",
      "domain": "",
      "upload_host": "",
      "token_ttl": 3600
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form",
      "before": {
        "service": "front.upload.UploadStorageHook.BeforeSaveUploadStorage"
      }
    }
  }
}
